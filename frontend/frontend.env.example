# Frontend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the filled-in .env file.
#
# IMPORTANT: Vite exposes every VITE_ variable to the browser bundle.
# Only put values here that are safe to be public.
# The Supabase secret / service_role key must NEVER appear in this file.

# Project URL from Supabase: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Client-side key. New key system: "Publishable key". Legacy: "anon" key.
# Safe to expose — access is still restricted by row-level security.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Base URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000
