# Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the filled-in .env file.

# --- Supabase / Postgres ---
# Connection string from Supabase: Connect dialog (or Settings > Database)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Project URL from Supabase: Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side key. New key system: "Secret key". Legacy: "service_role" key.
# This bypasses row-level security. Reserved for exactly three code paths:
# org signup, applying an approved correction, and the scheduled report job.
SUPABASE_SECRET_KEY=your-secret-key-here

# Client-side key (same "Publishable key" / anon key the frontend uses).
# Needed here too: Supabase's gateway requires an `apikey` header on every
# request regardless of auth method. Per-user RLS enforcement comes from the
# backend forwarding the caller's own JWT as the Authorization bearer token
# on every normal request — this key is NOT what grants that access.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# No JWT secret needed: Supabase signs access tokens with an asymmetric key
# (ES256) and the backend verifies them against the project's public JWKS
# endpoint (https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json),
# fetched automatically — nothing to configure here.

# --- App config ---
ENVIRONMENT=development
API_PORT=8000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Background jobs ---
# Cron expression for scheduled report generation
REPORT_SCHEDULE_CRON=0 6 * * 1
